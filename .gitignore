# =============================================================================
# DogBank - Git Ignore
# =============================================================================

# Kubernetes Secrets - NEVER commit these files!
instrumented/k8s/base/secrets.yaml
instrumented/k8s/secrets.local.sh
non-instrumented/k8s/base/secrets.yaml
non-instrumented/k8s/secrets.local.sh

# Terraform State Files - contain secrets!
*.tfplan
*.tfstate
*.tfstate.backup
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Environment files with secrets
.env
.env.local
*.secret

# Temporary files
*.tmp
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Tool artifacts (not project code)
.playwright-cli/
.codex-tmp/
finops-output/
instrumented/docker/dogbank/data-observability-poc/

# Local build outputs
instrumented/docker/build/
instrumented/docker/dogbank-ios-native/build/
instrumented/docker/dogbank-flutter/isrgrootx2.pem
**/xcuserdata/

# Python bytecode cache
__pycache__/
*.pyc
