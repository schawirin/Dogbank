<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="ConsoleJson" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:InvestmentDatadogLogLayout.json"/>
        </Console>
        <RollingFile name="FileJson"
                     fileName="${env:DOGBANK_LOG_DIR:-/tmp/dogbank-logs}/${env:DD_SERVICE:-investment-service}.log"
                     filePattern="${env:DOGBANK_LOG_DIR:-/tmp/dogbank-logs}/${env:DD_SERVICE:-investment-service}-%d{yyyy-MM-dd}-%i.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:InvestmentDatadogLogLayout.json"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="3"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="investment.audit" level="info" additivity="false">
            <AppenderRef ref="ConsoleJson"/>
            <AppenderRef ref="FileJson"/>
        </Logger>

        <Logger name="com.dogbank.investment" level="info" additivity="false">
            <AppenderRef ref="ConsoleJson"/>
            <AppenderRef ref="FileJson"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="ConsoleJson"/>
            <AppenderRef ref="FileJson"/>
        </Root>

        <Logger name="org.springframework.web" level="info"/>
        <Logger name="org.springframework.security" level="warn"/>
        <Logger name="org.hibernate" level="warn"/>
        <Logger name="org.apache.catalina" level="warn"/>
        <Logger name="org.apache.tomcat" level="warn"/>
        <Logger name="com.zaxxer.hikari" level="warn"/>
    </Loggers>
</Configuration>
