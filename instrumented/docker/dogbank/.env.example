# =============================================================================
# DogBank - Variaveis de Ambiente (EXEMPLO)
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env
#
# Ou use o script interativo:
#   ./setup.sh
# =============================================================================

# =============================================================================
# DATABASE (pode manter os valores padrao)
# =============================================================================
DB_URL=jdbc:postgresql://postgres:5432/dogbank
DB_USER=dogbank
DB_PASSWORD=dog1234
POSTGRES_PASSWORD=dog1234
POSTGRES_USER=dogbank
POSTGRES_DB=dogbank

# =============================================================================
# DATADOG - APM, Logs e Metricas
# =============================================================================
# Obtenha suas chaves em:
#   API Key: https://app.datadoghq.com/organization-settings/api-keys
#   App Key: https://app.datadoghq.com/organization-settings/application-keys
# =============================================================================
DD_API_KEY=sua-datadog-api-key-aqui
DD_APP_KEY=sua-datadog-app-key-aqui
DD_SITE=datadoghq.com
DD_METRICS_ENABLED=true

# =============================================================================
# EVILDOG SECURITY-DEMO PREFLIGHT
# =============================================================================
# ID do workflow publicado que bloqueia o segmento sem MFA. O preflight lê o
# workflow pela API e confirma que ele usa /block-no-mfa e sua HTTP Connection
# secret-backed; nunca armazene o token no workflow nem neste arquivo.
DOGBANK_SECURITY_WORKFLOW_ID=seu-workflow-id-aqui
# ID da HTTP Connection criada no Datadog para o endpoint DogBank. A connection
# guarda o token ADMIN_BLOCK_TOKEN (e pode ser pública HTTPS ou usar um Private
# Action Runner); o
# script instrumented/k8s/scripts/create-datadog-workflows.py só cria o
# workflow de contenção quando esta variável está preenchida.
DOGBANK_HTTP_CONNECTION_ID=sua-http-connection-id-aqui
# Base pública do laboratório. Para compose local, use https://lab.dogbank.dog
# apenas se o hostname estiver encaminhado para o proxy local.
DOGBANK_BASE=https://lab.dogbank.dog
# Token injetado somente no auth-service e cadastrado separadamente em
# Workflow Automation > Settings > Secrets como ADMIN_BLOCK_TOKEN.
DOGBANK_ADMIN_BLOCK_TOKEN=defina-um-token-unico-fora-do-repositorio
# Tokens internos do EvilDog: controle da UI e telemetria dos agentes efêmeros.
# Gere-os localmente com ./setup-demo-secrets.sh; jamais use variáveis VITE_ ou
# REACT_APP_ para expô-los no frontend.
EVILDOG_CONTROL_TOKEN=defina-um-token-unico-fora-do-repositorio
EVILDOG_AGENT_TOKEN=defina-um-token-unico-fora-do-repositorio

# =============================================================================
# DATADOG RUM - Real User Monitoring (Frontend)
# =============================================================================
# Configure em: https://app.datadoghq.com/rum/application/create
# Crie uma aplicacao chamada "dog-bank" e copie as credenciais
# =============================================================================
VITE_DD_CLIENT_TOKEN=seu-client-token-aqui
VITE_DD_APPLICATION_ID=seu-application-id-aqui
VITE_DD_SERVICE=dog-bank
VITE_DD_ENV=development

# =============================================================================
# GROQ - LLM para o Chatbot (DogBot)
# =============================================================================
# Groq oferece inferencia super rapida com tier GRATUITO!
# Obtenha sua chave em: https://console.groq.com/
# A chave comeca com "gsk_"
# =============================================================================
GROQ_API_KEY=sua-groq-api-key-aqui
OPENAI_API_KEY=sua-groq-api-key-aqui
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
# llama-3.1-8b-instant/mixtral-8x7b-32768 were retired from Groq's catalog
# (check current options at https://console.groq.com/docs/models)
OPENAI_MODEL=openai/gpt-oss-20b

# =============================================================================
# RABBITMQ (pode manter os valores padrao)
# =============================================================================
RABBITMQ_DEFAULT_USER=dogbank
RABBITMQ_DEFAULT_PASS=dog1234

# =============================================================================
# REDIS (pode manter vazio)
# =============================================================================
REDIS_PASSWORD=
